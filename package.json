{
  "name": "@penqwin/mcp",
  "version": "0.0.1",
  "description": "MCP server that exposes AST skeleton tools from the Penqwin platform",
  "type": "module",
  "bin": {
    "penqwin-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit"
  },
  "files": ["dist"],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5"
  }
}
